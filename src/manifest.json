{
  "manifest_version": 3,
  "name": "anigamer-ambilight｜動畫瘋環境光與主題編輯器",
  "description": "動畫瘋播放頁環境光與主題編輯器。光暈、配色與版型可獨立使用，支援字體、透明度、收合與自訂色碼。非官方工具。",
  "version": "1.0.0",
  "minimum_chrome_version": "121",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "動畫瘋環境光設定",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://ani.gamer.com.tw/*"
      ],
      "css": [
        "content.css",
        "effects.css",
        "settings-ui.css"
      ],
      "js": [
        "settings.js",
        "black-bars.js",
        "ambient-renderer.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "version_name": "1.0.0"
}